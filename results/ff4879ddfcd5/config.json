{
  "data": {
    "pipeline": "bpe",
    "seq_len": 256,
    "max_articles_train": null,
    "max_articles_val": null,
    "cache_dir": "data/cache",
    "morpholex_path": "data/MorphoLEX_en.xlsx",
    "vocab_csv": "data/our_final_vocab.csv",
    "bpe_path": "data/bpe_17k.json",
    "spacy_model": "en_core_web_sm"
  },
  "surface": {
    "emit_punctuation": true,
    "emit_digits": true,
    "emit_inflection": true,
    "emit_whitespace": true,
    "emit_case": true
  },
  "frozen": {
    "facts": [],
    "dep_granularity": "coarse",
    "amplify": 1,
    "shuffle_codes": false,
    "trainable": false,
    "scale": 1.0,
    "root_width": 16
  },
  "model": {
    "d_model": 128,
    "n_layers": 4,
    "n_heads": 4,
    "dropout": 0.1,
    "tie_output": "none"
  },
  "train": {
    "batch_size": 32,
    "lr": 0.001,
    "warmup": 100,
    "max_steps": 10000,
    "lr_horizon": 10000,
    "eval_every": 500,
    "patience": 6,
    "grad_clip": 1.0,
    "weight_decay": 0.01,
    "seed": 0,
    "eval_buckets": true
  }
}